# Kopiraj ovaj fajl u .env.agent-test.local (taj je već gitignore-ovan
# preko .env.* pravila) i popuni pravim kredencijalima test naloga.
#
# Test nalog napravi RUČNO kroz normalnu registraciju u app-u — ne
# programski. Jasno ga označi (npr. ime "Agent Test") da se ne pomeša sa
# pravim korisnicama. Ovaj nalog postoji u pravoj produkcionoj bazi, pa
# tester-agent sme da ga koristi SAMO za gledanje/screenshot privatnih
# stranica — nikad za pisanje na javnim/deljenim delovima (forum, ocene
# lekara i sl.)

AGENT_TEST_EMAIL=
AGENT_TEST_PASSWORD=
